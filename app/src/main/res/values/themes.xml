<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Quickbot" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- Прозрачная тема для AssistActivity — убирает белую вспышку -->
    <style name="Theme.Quickbot.Assist" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>